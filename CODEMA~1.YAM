# Codemagic cloud build — Neon Drop Android (.aab) — no Mac needed.
# IMPORTANT: uses your saved keystore so every build is signed with the SAME key.
# Setup (once): Codemagic -> Settings -> Code signing identities -> Android keystores
#   -> Add keystore -> upload keystore.jks
#      Reference name: neondrop_keystore
#      Keystore password: NeonDrop2026
#      Key alias: neondrop
#      Key password: NeonDrop2026

workflows:
  android-neondrop:
    name: Neon Drop Android
    max_build_duration: 60
    environment:
      android_signing:
        - neondrop_keystore     # the keystore you uploaded in Code signing identities
      node: 20
      java: 17
      vars:
        ADMOB_APP_ID: "ca-app-pub-4731088109605726~9292910932"
    scripts:
      - name: Install dependencies
        script: npm install

      - name: Add Android platform + sync web assets
        script: |
          npx cap add android || true
          npx cap sync android

      - name: Target Android 35 + set version
        script: |
          # Google Play requires new apps to target API level 35
          sed -i -E 's/compileSdkVersion = [0-9]+/compileSdkVersion = 35/' android/variables.gradle
          sed -i -E 's/targetSdkVersion = [0-9]+/targetSdkVersion = 35/' android/variables.gradle
          # allow compiling against SDK 35 with the current Android Gradle Plugin
          echo "android.suppressUnsupportedCompileSdk=35" >> android/gradle.properties
          # bump the version so Play accepts the new bundle
          sed -i -E 's/versionCode [0-9]+/versionCode 2/' android/app/build.gradle
          echo "--- variables.gradle ---"; cat android/variables.gradle

      - name: Inject AdMob App ID into AndroidManifest
        script: |
          MANIFEST=android/app/src/main/AndroidManifest.xml
          if ! grep -q "com.google.android.gms.ads.APPLICATION_ID" "$MANIFEST"; then
            python3 - "$MANIFEST" "$ADMOB_APP_ID" <<'PY'
          import sys
          path, appid = sys.argv[1], sys.argv[2]
          s = open(path).read()
          meta = '        <meta-data android:name="com.google.android.gms.ads.APPLICATION_ID" android:value="%s"/>\n' % appid
          s = s.replace("</application>", meta + "    </application>")
          open(path, "w").write(s)
          print("AdMob App ID injected")
          PY
          fi

      - name: Configure release signing (use uploaded keystore)
        script: |
          cat >> android/app/build.gradle <<'GRADLE'

          android {
              signingConfigs {
                  release {
                      storeFile file(System.getenv("CM_KEYSTORE_PATH"))
                      storePassword System.getenv("CM_KEYSTORE_PASSWORD")
                      keyAlias System.getenv("CM_KEY_ALIAS")
                      keyPassword System.getenv("CM_KEY_PASSWORD")
                  }
              }
              buildTypes {
                  release {
                      signingConfig signingConfigs.release
                  }
              }
          }
          GRADLE

      - name: Build signed AAB
        script: |
          cd android
          ./gradlew bundleRelease

    artifacts:
      - android/app/build/outputs/**/*.aab
